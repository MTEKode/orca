{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "id": "agent-filter",
  "name": "Agent Filter",
  "version": "1.0.0",
  "description": "Filter and manage which agents are available in the catalog",
  "execution": "trusted-worker",
  "pluginApi": 1,
  "engines": {
    "orca": ">=1.4.246"
  },
  "main": "dist/worker.js",
  "contributes": {
    "settings": [
      {
        "key": "enabledAgents",
        "title": "Enabled Agents",
        "description": "Comma-separated list of agent IDs to show in the catalog",
        "type": "string",
        "default": "claude,codex,opencode,pi,antigravity"
      },
      {
        "key": "defaultSurface",
        "title": "Default Surface",
        "description": "Default interface for new agent sessions",
        "type": "string",
        "enum": ["chat", "terminal"],
        "enumLabels": ["Chat", "Terminal"],
        "default": "chat"
      }
    ],
    "panels": [
      {
        "id": "agent-filter-config",
        "title": "Agent Filter",
        "entry": "dist/config-panel.tsx",
        "icon": "$(filter)"
      }
    ]
  },
  "capabilities": ["settings:own", "storage:own"]
}
