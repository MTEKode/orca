{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "id": "task-provider-filter",
  "name": "Task Provider Filter",
  "version": "1.0.0",
  "description": "Filter which task providers (GitHub, Linear, etc.) are available",
  "execution": "trusted-worker",
  "pluginApi": 1,
  "engines": {
    "orca": ">=1.4.246"
  },
  "main": "dist/worker.js",
  "contributes": {
    "settings": [
      {
        "key": "enabledProviders",
        "title": "Enabled Task Providers",
        "description": "Comma-separated list of task provider IDs",
        "type": "string",
        "default": "github,linear"
      }
    ],
    "panels": [
      {
        "id": "task-provider-config",
        "title": "Task Providers",
        "entry": "dist/config-panel.tsx",
        "icon": "$(list-ordered)"
      }
    ]
  },
  "capabilities": ["settings:own", "storage:own"]
}
